<Window x:Class="CatPrint.Views.EggWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="❤" Width="360" Height="430"
        MinWidth="320" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBg}">
    <Grid>
        <StackPanel x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="20" Opacity="0">
            <StackPanel.RenderTransform>
                <ScaleTransform x:Name="Pop" ScaleX="0.9" ScaleY="0.9"/>
            </StackPanel.RenderTransform>
            <Image Source="pack://application:,,,/Assets/logo256.png"
                   Width="150" Height="150"
                   HorizontalAlignment="Center"/>
            <TextBlock Text="Это приложение писалось для моей любимой жены"
                       FontSize="15" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,18,0,0"
                       Foreground="{DynamicResource TextMuted}"/>
            <TextBlock Text="Зайка, я тебя люблю!"
                       FontSize="21" FontWeight="Bold" TextAlignment="Center"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Это для тебя ❤"
                       FontSize="15" TextAlignment="Center"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource TextMuted}"/>
            <TextBlock Text="🐾 ❤ 🐾" FontSize="20" TextAlignment="Center"
                       Margin="0,14,0,0"/>
            <Button Content="Закрыть" Width="120" Height="32"
                    HorizontalAlignment="Center" Margin="0,18,0,0"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Pop"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.9" To="1.0" Duration="0:0:0.25"/>
                    <DoubleAnimation Storyboard.TargetName="Pop"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.9" To="1.0" Duration="0:0:0.25"/>
                    <DoubleAnimation Storyboard.TargetName="Card"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>

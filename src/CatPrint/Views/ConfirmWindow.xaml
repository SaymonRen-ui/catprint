<Window x:Class="CatPrint.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height"
        MinHeight="150"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBg}">
    <StackPanel Margin="18">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="❓" FontSize="30" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtMessage" Margin="14,0,0,0"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="300" FontSize="13"
                       Foreground="{DynamicResource TextPrimary}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="BtnYes" Content="Да" Width="92" Height="30"
                    Click="BtnYes_Click"/>
            <Button x:Name="BtnNo" Content="Нет" Width="92" Height="30"
                    Margin="8,0,0,0" IsCancel="True" Click="BtnNo_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="CatPrint.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал" Width="560" Height="420"
        MinWidth="400" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="8">
            <ListBox x:Name="LstLog" FontSize="12" FontFamily="Consolas, Courier New"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Копировать" Width="110" Height="30" Click="BtnCopy_Click"/>
            <Button Content="Очистить" Width="110" Height="30" Margin="8,0,0,0" Click="BtnClear_Click"/>
            <Button Content="Закрыть" Width="110" Height="30" Margin="8,0,0,0" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>

<UserControl x:Class="CatPrint.Views.EmojiPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="470" Height="430">
    <Border Background="{DynamicResource PanelBg}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Padding="8">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" FontSize="11"
                       Foreground="{DynamicResource TextMuted}"
                       TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="Символы ★ ♥ ● печатаются чётче всего. А ещё на бумаге работает Win+. — системная панель Windows со всеми эмодзи и поиском."/>
            <WrapPanel x:Name="CatBar" DockPanel.Dock="Top"
                       Orientation="Horizontal" Margin="0,0,0,6"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="ItemsPanel"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>

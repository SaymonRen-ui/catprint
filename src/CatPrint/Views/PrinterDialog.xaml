<Window x:Class="CatPrint.Views.PrinterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Принтер" Width="440" Height="480"
        MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">
    <StackPanel Margin="14">
        <TextBlock x:Name="TxtStatus" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   Text="● Не подключено"/>

        <Button x:Name="BtnScan" Content="🔍 Сканировать устройства" Height="32"
                Margin="0,12,0,0" Click="BtnScan_Click"/>
        <ListBox x:Name="LstDevices" Height="150" Margin="0,8,0,0"/>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnConnect" Content="Подключить" Grid.Column="0"
                    Margin="0,0,4,0" Height="32" Click="BtnConnect_Click"/>
            <Button x:Name="BtnDisconnect" Content="Отключить" Grid.Column="1"
                    Margin="4,0,0,0" Height="32" Click="BtnDisconnect_Click"/>
        </Grid>
        <Button x:Name="BtnQuick" Content="Быстро: найти MXW01"
                Margin="0,8,0,0" Height="28" Click="BtnQuick_Click"/>

        <Button x:Name="BtnStatus" Content="🔋 Запросить статус (A1)"
                Margin="0,8,0,0" Height="28" Click="BtnStatus_Click"
                ToolTip="Принтер отвечает в AE02 — ищем там батарею"/>

        <TextBlock Margin="0,12,0,0" FontSize="11"
                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                   Text="Параметры печати (плотность, паузы, порядок бит) — в ⚙ Настройках в шапке окна."/>

        <Button Content="Закрыть" Height="32" Margin="0,12,0,0"
                Click="BtnClose_Click"/>
    </StackPanel>
</Window>

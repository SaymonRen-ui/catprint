<Window x:Class="CatPrint.Views.ImageSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Картинка" Width="640" Height="520"
        MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#EEEEEE" CornerRadius="6"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="10" Margin="0,0,10,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Border Background="White" BorderBrush="#BBBBBB"
                        BorderThickness="1" HorizontalAlignment="Center">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="None"/>
                        <!-- Выделение обрезки: ведём мышью по картинке -->
                        <Canvas x:Name="CropCanvas" Background="Transparent"
                                Visibility="Collapsed"
                                MouseLeftButtonDown="Crop_Down"
                                MouseMove="Crop_Move"
                                MouseLeftButtonUp="Crop_Up">
                            <Rectangle x:Name="CropRectDark" Stroke="Black"
                                       StrokeThickness="5" Visibility="Collapsed"/>
                            <Rectangle x:Name="CropRect" Stroke="White"
                                       StrokeThickness="2" Visibility="Collapsed"/>
                        </Canvas>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Дизеринг" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
            <ComboBox x:Name="CmbDither" Margin="0,4,0,0" SelectionChanged="Opt_Changed">
                <ComboBoxItem Content="Порог"/>
                <ComboBoxItem Content="Флойд–Стейнберг"/>
                <ComboBoxItem Content="Аткинсон"/>
                <ComboBoxItem Content="Байер 4×4"/>
                <ComboBoxItem Content="Байер 8×8"/>
                <ComboBoxItem Content="Джарвис"/>
                <ComboBoxItem Content="Стуки"/>
                <ComboBoxItem Content="Берк"/>
                <ComboBoxItem Content="Сьерра"/>
                <ComboBoxItem Content="Случайный"/>
            </ComboBox>

            <Button x:Name="BtnAuto" Content="✨ Автоуровни" Margin="0,8,0,0" Height="28"
                    Click="BtnAuto_Click" ToolTip="Подобрать яркость и контраст по гистограмме"/>
            <ToggleButton x:Name="ChkBit" Content="👁 1-бит ✓" IsChecked="True"
                    Margin="0,8,0,0" Height="30"
                    Checked="ChkBit_Changed" Unchecked="ChkBit_Changed"
                    ToolTip="Переключатель вида: 1-битный растр или оригинал"/>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnPhotoPreset" Content="📷 Фото" Grid.Column="0"
                        Margin="0,0,4,0" Height="28" Click="BtnPhotoPreset_Click"
                        ToolTip="Флойд–Стейнберг + автоуровни: без кружков и сетки"/>
                <Button x:Name="BtnGraphicPreset" Content="✒️ Графика" Grid.Column="1"
                        Margin="4,0,0,0" Height="28" Click="BtnGraphicPreset_Click"
                        ToolTip="Порог: чёткие линии и текст"/>
            </Grid>

            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource TextMuted}" FontSize="12">
                <Run Text="Яркость: "/><Run x:Name="RunBright" Text="0"/>
            </TextBlock>
            <Slider x:Name="SldBright" Minimum="-100" Maximum="100" ValueChanged="Opt_Changed"/>

            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextMuted}" FontSize="12">
                <Run Text="Контраст: "/><Run x:Name="RunContrast" Text="0"/>
            </TextBlock>
            <Slider x:Name="SldContrast" Minimum="-100" Maximum="100" ValueChanged="Opt_Changed"/>

            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextMuted}" FontSize="12">
                <Run Text="Порог: "/><Run x:Name="RunThreshold" Text="128"/>
            </TextBlock>
            <Slider x:Name="SldThreshold" Minimum="1" Maximum="254" Value="128" ValueChanged="Opt_Changed"/>

            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextMuted}" FontSize="12">
                <Run Text="Гамма: "/><Run x:Name="RunGamma" Text="1,00"/>
            </TextBlock>
            <Slider x:Name="SldGamma" Minimum="0.2" Maximum="3" Value="1" ValueChanged="Opt_Changed"/>

            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextMuted}" FontSize="12">
                <Run Text="Насыщенность: "/><Run x:Name="RunSaturation" Text="100"/>
            </TextBlock>
            <Slider x:Name="SldSaturation" Minimum="0" Maximum="200" Value="100" ValueChanged="Opt_Changed"/>

            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextMuted}" FontSize="12" Text="Рамка"/>
            <ComboBox x:Name="CmbFrame" Margin="0,4,0,0" SelectionChanged="CmbFrame_Changed">
                <ComboBoxItem Content="Без рамки"/>
                <ComboBoxItem Content="Тонкая"/>
                <ComboBoxItem Content="Толстая"/>
                <ComboBoxItem Content="Двойная"/>
                <ComboBoxItem Content="Волнистая"/>
                <ComboBoxItem Content="Пунктир"/>
                <ComboBoxItem Content="Точки"/>
                <ComboBoxItem Content="Зигзаг"/>
            </ComboBox>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnRotate" Content="⟳ 0°" Grid.Column="0"
                        Margin="0,0,4,0" Height="28" Click="BtnRotate_Click"
                        ToolTip="Повернуть на 90° по часовой"/>
                <CheckBox x:Name="ChkMirror" Content="Зеркало" Grid.Column="1"
                          VerticalAlignment="Center" Margin="4,0,0,0"
                          Checked="Opt_Changed" Unchecked="Opt_Changed"/>
            </Grid>

            <CheckBox x:Name="ChkInvert" Content="Инверсия" Margin="0,12,0,0"
                      Checked="Opt_Changed" Unchecked="Opt_Changed"/>

            <Button x:Name="BtnCrop" Content="✂ Обрезать" Margin="0,8,0,0" Height="28"
                    Click="BtnCrop_Click"
                    ToolTip="Выделить область мышью на картинке, затем «✓ Применить»"/>
            <TextBlock x:Name="TxtCropHint" Margin="0,4,0,0" FontSize="11"
                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Text="Веди мышью по картинке, затем нажми «✓ Применить»"/>
            <Grid x:Name="CropActions" Margin="0,4,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnCropApply" Content="✓ Применить" Grid.Column="0"
                        Margin="0,0,4,0" Height="28" Click="BtnCropApply_Click"/>
                <Button x:Name="BtnCropReset" Content="Сброс" Grid.Column="1"
                        Margin="4,0,0,0" Height="28" Click="BtnCropReset_Click"/>
            </Grid>

            <TextBlock x:Name="TxtInfo" Margin="0,12,0,0" FontSize="11"
                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="ОК" Width="100" Height="32" IsDefault="True"
                        FontWeight="Bold" Click="BtnOk_Click"/>
                <Button Content="Отмена" Width="100" Height="32" Margin="8,0,0,0"
                        IsCancel="True"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

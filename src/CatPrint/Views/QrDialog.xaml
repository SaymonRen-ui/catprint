<Window x:Class="CatPrint.Views.QrDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR-код" Width="420" Height="480"
        MinWidth="360" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Текст кода" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
        <TextBox x:Name="TxtCode" Grid.Row="1" Margin="0,4,0,0" Height="64"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 TextChanged="TxtCode_TextChanged"/>

        <Border Grid.Row="2" Background="#EEEEEE" CornerRadius="6"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="10" Margin="0,10,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Border Background="White" BorderBrush="#BBBBBB"
                        BorderThickness="1" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Image x:Name="PreviewImage" Stretch="None"/>
                </Border>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0"
                    VerticalAlignment="Center">
            <ComboBox x:Name="CmbSize" Width="120" SelectionChanged="CmbSize_Changed">
                <ComboBoxItem Content="Малый"/>
                <ComboBoxItem Content="Средний"/>
                <ComboBoxItem Content="Крупный"/>
            </ComboBox>
            <TextBlock x:Name="TxtInfo" Margin="10,0,0,0" FontSize="11"
                       Foreground="{DynamicResource TextMuted}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="10,0,0,0">
                <Button x:Name="BtnOk" Content="ОК" Width="90" Height="32"
                        IsDefault="True" FontWeight="Bold" Click="BtnOk_Click"/>
                <Button Content="Отмена" Width="90" Height="32" Margin="8,0,0,0"
                        IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

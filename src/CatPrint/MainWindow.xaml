<Window x:Class="CatPrint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CatPrint.Views"
        Title="CatPrint"
        Width="1100" Height="750"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======= ШАПКА КАК В WORD ======= -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="10,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnLogo" Width="30" Height="30" Padding="1"
                            Background="Transparent" BorderThickness="0"
                            Click="BtnLogo_Click">
                        <Image Source="pack://application:,,,/Assets/logo32.png"
                               Width="24" Height="24"/>
                    </Button>
                    <TextBlock Text="CatPrint" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Button x:Name="BtnNew" Content="Новый" Height="30" Padding="10,0"
                            Margin="16,0,0,0" Click="BtnNew_Click"/>
                    <Button x:Name="BtnOpen" Content="Открыть" Height="30" Padding="10,0"
                            Margin="6,0,0,0" Click="BtnOpen_Click"/>
                    <Button x:Name="BtnSave" Content="Сохранить" Height="30" Padding="10,0"
                            Margin="6,0,0,0" Click="BtnSave_Click"/>
                    <Button x:Name="BtnClear" Content="🗑 Очистить" Height="30" Padding="10,0"
                            Margin="6,0,0,0" Click="BtnClear_Click" ToolTip="Очистить холст"/>
                    <Button x:Name="BtnPrint" Content="🖨 Печать" Height="34" Padding="18,0"
                            Margin="16,0,0,0" FontWeight="Bold" FontSize="14"
                            Background="{DynamicResource Accent}" Foreground="White"
                            BorderThickness="0" Click="BtnPrint_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnPower" Height="30" Padding="10,0"
                            Click="BtnPower_Click" ToolTip="Плотность и автожар">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔥" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPowerBtn" Text="68%" Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnTheme" Content="🌙" Width="36" Height="30" Padding="2"
                            FontSize="15" Margin="8,0,0,0" Click="BtnTheme_Click" ToolTip="Светлая / тёмная тема"/>
                    <Button x:Name="BtnSettings" Content="⚙" Width="36" Height="30" Padding="2"
                            FontSize="15" Margin="8,0,0,0" Click="BtnSettings_Click"
                            ToolTip="Настройки печати и приложения"/>
                    <Button x:Name="BtnLog" Content="📋" Width="36" Height="30" Padding="2"
                            FontSize="15" Margin="8,0,0,0" Click="BtnLog_Click"
                            ToolTip="Журнал сообщений и ошибок"/>
                    <Button x:Name="BtnPrinter" Height="30" Padding="10,0" Margin="8,0,0,0"
                            Click="BtnPrinter_Click" ToolTip="Настройки принтера">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PrinterDot" Width="10" Height="10" Fill="Gray"/>
                            <TextBlock x:Name="TxtPrinter" Text="Не подключено"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBattery" Text=""
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMuted}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======= РЕДАКТОР ======= -->
        <local:DocEditorView x:Name="Editor" Grid.Row="1"/>

        <!-- Всплывашка плотности: слайдер + авто. При Авто слайдер мёртвый. -->
        <Popup x:Name="PowerPopup" PlacementTarget="{Binding ElementName=BtnPower}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource PanelBg}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14" Width="270">
                <StackPanel>
                    <TextBlock x:Name="PowTitle" Text="Плотность"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <Slider x:Name="PowSlider" Minimum="0" Maximum="100"
                            Margin="0,8,0,0" ValueChanged="PowSlider_Changed"/>
                    <CheckBox x:Name="PowAuto" Content="Автоплотность"
                              Margin="0,8,0,0"
                              Checked="PowAuto_Changed" Unchecked="PowAuto_Changed"
                              ToolTip="Снижать жар на плотной заливке"/>
                    <CheckBox x:Name="PowAdaptive" Content="Адаптивный жар"
                              Margin="0,4,0,0"
                              Checked="PowAuto_Changed" Unchecked="PowAuto_Changed"
                              ToolTip="Модуляция жара по ходу печати"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ======= СТАТУС-БАР ======= -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0" FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="Готов."/>
                <ProgressBar x:Name="PrintProgress" Grid.Column="1" Height="10"
                             Minimum="0" Maximum="1" Value="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
